<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity3">

    <TextView
        android:id="@id/text"
        android:text="0"
        android:textSize="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="200dp"
        android:layout_marginRight="50dp"


        />

    <Button
        android:id="@+id/number_7"
        android:text="7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"

        android:layout_marginTop="300dp"
        android:layout_marginLeft="30dp"/>



    <Button
        android:id="@+id/number_8"
        android:text="8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_7"
        app:layout_constraintStart_toEndOf="@+id/number_7"
        />

    <Button
        android:id="@+id/number_9"
        android:text="9"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_8"
        app:layout_constraintStart_toEndOf="@+id/number_8"
        />

    <Button
        android:id="@+id/devide"
        android:text="÷"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_9"
        app:layout_constraintStart_toEndOf="@+id/number_9"
        />

    <Button
        android:id="@+id/number_4"
        android:text="4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/number_7"
        app:layout_constraintStart_toStartOf="@+id/number_7"
        />

    <Button
        android:id="@+id/number_5"
        android:text="5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_4"
        app:layout_constraintStart_toEndOf="@+id/number_4"
        />

    <Button
        android:id="@+id/number_6"
        android:text="6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_5"
        app:layout_constraintStart_toEndOf="@+id/number_5"
        />

    <Button
        android:id="@+id/times"
        android:text="×"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_6"
        app:layout_constraintStart_toEndOf="@+id/number_6"
        />

    <Button
        android:id="@+id/number_1"
        android:text="1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/number_4"
        app:layout_constraintStart_toStartOf="@+id/number_4"
        />

    <Button
        android:id="@+id/number_2"
        android:text="2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_1"
        app:layout_constraintStart_toEndOf="@+id/number_1"
        />

    <Button
        android:id="@+id/number_3"
        android:text="3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_2"
        app:layout_constraintStart_toEndOf="@+id/number_2"
        />

    <Button
        android:id="@+id/minus"
        android:text="-"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_3"
        app:layout_constraintStart_toEndOf="@+id/number_3"
        />

    <Button
        android:id="@+id/ac"
        android:text="ac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/number_1"
        app:layout_constraintStart_toStartOf="@+id/number_1"
        />

    <Button
        android:id="@+id/equal"
        android:text="="
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/number_0"
        app:layout_constraintStart_toEndOf="@+id/number_0"
        />

    <Button
        android:id="@+id/number_0"
        android:text="0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/ac"
        app:layout_constraintStart_toEndOf="@+id/ac"
        />

    <Button
        android:id="@+id/plus"
        android:text="+"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/equal"
        app:layout_constraintStart_toEndOf="@+id/equal"
        />

    <Button
        android:id="@+id/button_ok"
        android:text="OK"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/ac"
        app:layout_constraintStart_toStartOf="@+id/ac"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="50dp"

        />

    <Button
        android:id="@+id/button_cancel"
        android:text="cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@+id/button_ok"
        app:layout_constraintStart_toEndOf="@+id/button_ok"
        android:layout_marginLeft="50dp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>